# Databricks connection for `dbt build --target databricks` (profiles.yml reads these environment variables).
# Copy to .env (gitignored) or set them in your shell. NEVER commit real values or paste the token into chat.
# Step-by-step: docs/databricks.md

# SQL Warehouses -> your warehouse -> Connection details -> "Server hostname" (no https://)
DATABRICKS_HOST=dbc-xxxxxxxx-xxxx.cloud.databricks.com

# SQL Warehouses -> your warehouse -> Connection details -> "HTTP path"
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxxxxxx

# Settings -> Developer -> Access tokens -> Generate new token (personal access token; keep it secret)
DATABRICKS_TOKEN=dapi-your-token-here

# Unity Catalog catalog the landing notebook wrote to; Free Edition's default is `workspace`
DATABRICKS_CATALOG=workspace
